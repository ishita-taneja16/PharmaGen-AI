# Production Environment Configuration - PharmaGen AI
PROJECT_NAME="PharmaGen AI"
ENVIRONMENT="production"
LOG_LEVEL="WARNING"

# Production Secret Keys (Must be randomized 64-char strings)
SECRET_KEY="generate_a_random_production_secret_key_using_openssl_rand_hex_32"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Production Database (PostgreSQL + pgvector)
POSTGRES_USER="pharmagen_prod_user"
POSTGRES_PASSWORD="strong_production_database_password_2026"
POSTGRES_DB="pharmagen_prod_db"
POSTGRES_HOST="db"
POSTGRES_PORT=5432
DATABASE_URL="postgresql+asyncpg://pharmagen_prod_user:strong_production_database_password_2026@db:5432/pharmagen_prod_db"

# LLM & Vector AI Credentials
GEMINI_API_KEY="your_production_google_gemini_api_key"
EMBEDDING_MODEL="models/text-embedding-004"
LLM_MODEL="gemini-1.5-pro"

# MLOps & Observability
MLFLOW_TRACKING_URI="http://mlflow:5000"
PROMETHEUS_METRICS_ENABLED=true
